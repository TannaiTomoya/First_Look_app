# 環境設定
FLASK_ENV=development
FLASK_DEBUG=True

# セキュリティ
SECRET_KEY=your-secret-key-here-change-in-production

# データベース
DATABASE_PATH=instance/firstlook.db           # Flask config用（廃止予定）
FIRSTLOOK_DB_PATH=instance/firstlook.db       # 実際のDBパス（推奨）

# 永続パス設定（本番環境対応）
FIRSTLOOK_UPLOAD_DIR=instance/uploads         # アップロード画像保存先
FIRSTLOOK_LOG_DIR=instance/logs               # ログファイル保存先

# 本番環境の例（VPS / 自前サーバー）:
# FIRSTLOOK_DB_PATH=/var/lib/firstlook/firstlook.db
# FIRSTLOOK_UPLOAD_DIR=/var/lib/firstlook/uploads
# FIRSTLOOK_LOG_DIR=/var/log/firstlook

# 本番環境の例（Render.com / Fly.io / Railway）:
# FIRSTLOOK_DB_PATH=/data/firstlook.db
# FIRSTLOOK_UPLOAD_DIR=/data/uploads
# FIRSTLOOK_LOG_DIR=/data/logs

# API設定
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# アップロード設定
MAX_CONTENT_LENGTH=16777216  # 16MB（バイト単位）

# セッション設定（本番環境）
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
