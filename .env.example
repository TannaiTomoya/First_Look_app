# 環境設定
FLASK_ENV=development
FLASK_DEBUG=True

# セキュリティ
SECRET_KEY=your-secret-key-here-change-in-production

# データベース
DATABASE_PATH=instance/firstlook.db           # Flask config用（廃止予定）
FIRSTLOOK_DB_PATH=instance/firstlook.db       # 実際のDBパス（推奨）

# 本番環境の例:
# FIRSTLOOK_DB_PATH=/var/lib/firstlook/firstlook.db
# または Render.com:
# FIRSTLOOK_DB_PATH=/opt/render/project/data/firstlook.db

# API設定
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# アップロード設定
MAX_CONTENT_LENGTH=16777216  # 16MB（バイト単位）

# セッション設定（本番環境）
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
