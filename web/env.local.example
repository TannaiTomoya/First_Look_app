# FirstLook (Next.js) 入力型枠
# 1) このファイルをコピー:  cp env.local.example .env.local
# 2) .env.local の「...」だけ実値に置換。値はチャットに貼らない。

# ============================================================
# 画面1: Stripe Project（env には入れない。ダッシュボード上の設定）
#   Project name   → firstlook
#   Project ID     → 自動生成のまま（コード未使用）
#   Project region → Northeast Asia (Tokyo) のまま
# ============================================================

# 本番URL（独自ドメインなし）
NEXT_PUBLIC_SITE_URL=https://firstlook.tomobou5912.workers.dev

# ============================================================
# Supabase → Project Settings → API
#   Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   anon / public        → NEXT_PUBLIC_SUPABASE_ANON_KEY   (eyJ で始まるJWT)
#   service_role         → SUPABASE_SERVICE_ROLE_KEY       (公開禁止)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role

# ============================================================
# 画面2: Stripe → Developers → API keys（テストモード）
#   公開可能キー (pk_test_...) → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   シークレットキー (sk_test_...) → STRIPE_SECRET_KEY   (公開禁止)
#   Webhook署名シークレット        → STRIPE_WEBHOOK_SECRET
#     今は whsec_... のままでOK。Webhook作成後に入れる
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 任意（後回し可）
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_CF_BEACON_TOKEN=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
